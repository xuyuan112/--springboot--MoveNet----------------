{"effective_mode":"compact","effective_text_preview_length":200,"nodes":[{"end_index":0,"paragraph_id":"1E37E78E","paragraph_index":1,"start_index":0,"type":"Paragraph"},{"end_index":1,"paragraph_id":"3C6FCF1C","paragraph_index":2,"start_index":1,"type":"Paragraph"},{"end_index":2,"paragraph_id":"5AA7B78D","paragraph_index":3,"start_index":2,"type":"Paragraph"},{"end_index":14,"has_highlights":true,"paragraph_id":"45496497","paragraph_index":4,"start_index":3,"text_preview":"毕 业 设 计（论文）","type":"Paragraph"},{"end_index":15,"paragraph_id":"637E78E7","paragraph_index":5,"start_index":15,"type":"Paragraph"},{"end_index":16,"paragraph_id":"01A594E6","paragraph_index":6,"start_index":16,"type":"Paragraph"},{"end_index":57,"paragraph_id":"58B24B7B","paragraph_index":7,"start_index":17,"text_preview":"题　　目：基于SpringBoot与MoveNet的康复训练辅助平台的设计与实现","type":"Paragraph"},{"end_index":68,"paragraph_id":"24D96A2E","paragraph_index":8,"start_index":58,"text_preview":"学　　院：计算机学院","type":"Paragraph"},{"end_index":78,"paragraph_id":"532E4309","paragraph_index":9,"start_index":69,"text_preview":"专业名称：软件工程","type":"Paragraph"},{"end_index":96,"paragraph_id":"733EEC1C","paragraph_index":10,"start_index":79,"text_preview":"学　　号：202530495223","type":"Paragraph"},{"end_index":104,"paragraph_id":"64800821","paragraph_index":11,"start_index":97,"text_preview":"学生姓名：许袁","type":"Paragraph"},{"end_index":116,"paragraph_id":"4F12EED7","paragraph_index":12,"start_index":105,"text_preview":"指导教师：【指导教师】","type":"Paragraph"},{"end_index":117,"paragraph_id":"6DDAF6D4","paragraph_index":13,"start_index":117,"type":"Paragraph"},{"end_index":128,"paragraph_id":"39BBEFCD","paragraph_index":14,"start_index":118,"text_preview":"2026 年 6 月","type":"Paragraph"},{"end_index":130,"paragraph_id":"7633BFC8","paragraph_index":15,"start_index":129,"type":"Paragraph"},{"end_index":135,"heading_level":1,"paragraph_id":"0D2CA730","paragraph_index":16,"start_index":131,"text_preview":"摘　　要","type":"Heading"},{"end_index":321,"paragraph_id":"01001B75","paragraph_index":17,"start_index":136,"text_preview":"随着我国人口老龄化进程加快，脑卒中、骨关节损伤及运动损伤等患者的数量持续增加，康复训练的社会需求日益旺盛。康复训练的效果高度依赖动作","type":"Paragraph"},{"end_index":597,"paragraph_id":"14E7C3B0","paragraph_index":18,"start_index":322,"text_preview":"针对上述问题，本文设计并实现了一个基于SpringBoot框架与MoveNet模型的人体姿态评估康复训练辅助平台。平台采用前后端分离的B/S架构，并将姿态推理完","type":"Paragraph"},{"end_index":833,"paragraph_id":"72B9FC08","paragraph_index":19,"start_index":598,"text_preview":"服务端基于SpringBoot3框架，结合MyBatis-Plus、MySQL、Redis、JWT与MinIO等技术，实现了账户与权限、动作与算法、康复计划、姿态评估与训练、数据与报告、公","type":"Paragraph"},{"end_index":922,"paragraph_id":"7039AC00","paragraph_index":20,"start_index":834,"text_preview":"测试结果表明，平台能够在普通设备上稳定完成端侧的实时姿态评估与动作计数，在相同数据与相同动作版本下评分结果保持一致，可为康复训练的量","type":"Paragraph"},{"end_index":962,"paragraph_id":"28FDC845","paragraph_index":21,"start_index":923,"text_preview":"关键词：SpringBoot；MoveNet；人体姿态估计；康复训练；动作评估","type":"Paragraph"},{"end_index":964,"paragraph_id":"6549B140","paragraph_index":22,"start_index":963,"type":"Paragraph"},{"end_index":973,"heading_level":1,"paragraph_id":"7548EACF","paragraph_index":23,"start_index":965,"text_preview":"Abstract","type":"Heading"},{"end_index":1771,"paragraph_id":"23B9AB72","paragraph_index":24,"start_index":974,"text_preview":"With the acceleration of population aging in China, the number of patients with stroke, osteoarticular injuries and sports injuries keeps increasing, and the demand for rehabilitation training is grow","type":"Paragraph"},{"end_index":2763,"paragraph_id":"385A079A","paragraph_index":25,"start_index":1772,"text_preview":"To address these problems, this paper designs and implements a human pose evaluation rehabilitation training assistance platform based on the SpringBoot framework and the MoveNet model. The platform a","type":"Paragraph"},{"end_index":3605,"paragraph_id":"29D8328A","paragraph_index":26,"start_index":2764,"text_preview":"The server is built on the SpringBoot3 framework and integrates MyBatis-Plus, MySQL, Redis, JWT and MinIO to implement seven business domains, namely account and permission, action and algorithm, reha","type":"Paragraph"},{"end_index":3937,"paragraph_id":"58DFBE8C","paragraph_index":27,"start_index":3606,"text_preview":"Test results show that the platform can stably complete client-side real-time pose evaluation and action counting on ordinary devices, and the scoring results remain consistent under the same data and","type":"Paragraph"},{"end_index":4035,"paragraph_id":"6B256A3F","paragraph_index":28,"start_index":3938,"text_preview":"Key words: SpringBoot; MoveNet; Human Pose Estimation; Rehabilitation Training; Action Evaluation","type":"Paragraph"},{"end_index":4037,"paragraph_id":"16B6631F","paragraph_index":29,"start_index":4036,"type":"Paragraph"},{"end_index":4042,"paragraph_id":"3FDDEAAC","paragraph_index":30,"start_index":4038,"text_preview":"目　　录","type":"Paragraph"},{"end_index":4101,"paragraph_id":"250F46BE","paragraph_index":31,"start_index":4043,"type":"Paragraph"},{"end_index":4102,"paragraph_id":"42F82F10","paragraph_index":32,"start_index":4102,"type":"Paragraph"},{"end_index":4110,"heading_level":1,"paragraph_id":"35370D0C","paragraph_index":33,"start_index":4103,"text_preview":"第一章  绪论","type":"Heading"},{"end_index":4120,"heading_level":2,"paragraph_id":"62F49817","paragraph_index":34,"start_index":4111,"text_preview":"1.1  课题背景","type":"Heading"},{"end_index":4309,"paragraph_id":"339CE95D","paragraph_index":35,"start_index":4121,"text_preview":"康复医学是帮助患者恢复运动功能、提高生活自理能力的重要学科。近年来，随着我国人口老龄化进程加快，脑卒中、帕金森病、骨关节损伤及运动损","type":"Paragraph"},{"end_index":4603,"paragraph_id":"66AC76AD","paragraph_index":36,"start_index":4310,"text_preview":"康复训练的核心在于通过反复、规范的动作练习重建神经肌肉控制能力，其效果高度依赖动作的规范程度与训练的连续性。然而，传统康复训练主要由","type":"Paragraph"},{"end_index":4926,"paragraph_id":"064AA228","paragraph_index":37,"start_index":4604,"text_preview":"人体姿态估计（Human Pose Estimation）技术的发展为解决上述问题提供了新的技术途径。姿态估计旨在从图像或视频中定位人体的关键关节，得到人体骨架","type":"Paragraph"},{"end_index":5111,"paragraph_id":"6F91C5FE","paragraph_index":38,"start_index":4927,"text_preview":"本课题正是在上述背景下提出的。课题结合软件工程专业实践，以“将轻量级姿态估计模型与康复训练业务流程相结合”为出发点，设计并实现一个基","type":"Paragraph"},{"end_index":5121,"heading_level":2,"paragraph_id":"1DACF683","paragraph_index":39,"start_index":5112,"text_preview":"1.2  课题意义","type":"Heading"},{"end_index":5345,"paragraph_id":"0E93EB29","paragraph_index":40,"start_index":5122,"text_preview":"（1）技术意义。本课题将轻量级人体姿态估计模型引入浏览器端康复训练场景，探索了在低算力终端上实现实时动作量化评估的工程实现方法。平台以","type":"Paragraph"},{"end_index":5550,"paragraph_id":"398ED69F","paragraph_index":41,"start_index":5346,"text_preview":"（2）应用价值。平台为三类用户提供了针对性的支持：对患者而言，居家训练时可通过摄像头获得实时的动作评分与纠错提示，训练过程被自动记录并","type":"Paragraph"},{"end_index":5646,"paragraph_id":"04140E61","paragraph_index":42,"start_index":5551,"text_preview":"（3）隐私与安全价值。平台将姿态推理完全放在浏览器本地执行，服务器只接收汇总指标、错误摘要与质量指标，不上传原始视频及逐帧关键点数据，","type":"Paragraph"},{"end_index":5772,"paragraph_id":"64EC19E6","paragraph_index":43,"start_index":5647,"text_preview":"（4）综合意义。本课题将姿态估计这一人工智能技术与康复训练这一现实医疗需求结合起来，以软件工程的方法完成需求分析、系统设计、编码实现与","type":"Paragraph"},{"end_index":5785,"heading_level":2,"paragraph_id":"7C22EE9F","paragraph_index":44,"start_index":5773,"text_preview":"1.3  国内外研究现状","type":"Heading"},{"end_index":5799,"heading_level":3,"paragraph_id":"16DD5FB5","paragraph_index":45,"start_index":5786,"text_preview":"1.3.1  国外研究现状","type":"Heading"},{"end_index":6056,"paragraph_id":"601194AF","paragraph_index":46,"start_index":5800,"text_preview":"国外对人体姿态估计的研究起步较早。早期方法主要依赖可变形部件模型等人工特征，在复杂背景下鲁棒性有限。2017年，Cao等人提出OpenPose，采用自底","type":"Paragraph"},{"end_index":6330,"paragraph_id":"4AA787CC","paragraph_index":47,"start_index":6057,"text_preview":"面向移动端和低算力设备，Google先后提出了BlazePose与MoveNet等轻量化模型。BlazePose通过轻量骨干网络与编码解码结构实现人体关键点检测，被应用于MediaPi","type":"Paragraph"},{"end_index":6526,"paragraph_id":"67A99BAF","paragraph_index":48,"start_index":6331,"text_preview":"在康复训练领域，国外研究者较早尝试将姿态估计应用于动作质量评价。部分研究利用Kinect等深度传感器采集三维关节坐标，通过计算关节角度活动范","type":"Paragraph"},{"end_index":6540,"heading_level":3,"paragraph_id":"00BB9494","paragraph_index":49,"start_index":6527,"text_preview":"1.3.2  国内研究现状","type":"Heading"},{"end_index":6765,"paragraph_id":"0E66894D","paragraph_index":50,"start_index":6541,"text_preview":"国内在姿态估计与康复评估方面同样开展了大量研究。在算法层面，研究者围绕关键点检测精度、遮挡鲁棒性和动作识别准确率进行了改进。例如，郑","type":"Paragraph"},{"end_index":6938,"paragraph_id":"1970D033","paragraph_index":51,"start_index":6766,"text_preview":"在应用层面，电子科技大学2025年的研究《面向视频的太极拳康复训练评估研究与实现》面向视频数据，实现了动作的评估与反馈，探索了将姿态估计技","type":"Paragraph"},{"end_index":7058,"paragraph_id":"22BBDB8A","paragraph_index":52,"start_index":6939,"text_preview":"总体来看，国内外研究在姿态估计精度和动作识别方法上已较为深入，为本课题提供了良好的理论与技术基础。但现有研究多聚焦于算法本身，面向真","type":"Paragraph"},{"end_index":7071,"heading_level":2,"paragraph_id":"2D902A22","paragraph_index":53,"start_index":7059,"text_preview":"1.4  当前存在的问题","type":"Heading"},{"end_index":7108,"paragraph_id":"0BAEB4DA","paragraph_index":54,"start_index":7072,"text_preview":"结合上述研究现状与实际康复训练场景，当前相关系统与研究中仍存在以下问题：","type":"Paragraph"},{"end_index":7203,"paragraph_id":"40790B19","paragraph_index":55,"start_index":7109,"text_preview":"（1）算法部署成本较高。主流高精度姿态估计方法多依赖高分辨率网络与较大算力，通常部署在具有图形处理器的服务器上，对普通家庭环境而言部署","type":"Paragraph"},{"end_index":7287,"paragraph_id":"2AC971E9","paragraph_index":56,"start_index":7204,"text_preview":"（2）业务闭环不完整。多数研究聚焦于单个动作的识别或评分，缺少康复计划制定、训练任务生成、训练记录汇总、评估报告审核等环节的衔接，难以","type":"Paragraph"},{"end_index":7367,"paragraph_id":"3D6EF82F","paragraph_index":57,"start_index":7288,"text_preview":"（3）数据质量缺乏门控。在居家采集条件下，光照变化、遮挡、出画等问题普遍存在，若不加以判别而直接将低质量数据纳入评分，会导致评价结果失","type":"Paragraph"},{"end_index":7438,"paragraph_id":"1FFF98DD","paragraph_index":58,"start_index":7368,"text_preview":"（4）患者隐私存在隐患。部分方案需要将原始训练视频上传至服务器处理，视频中含有患者的面部与身体特征，一旦泄露将带来隐私风险，患者接受度","type":"Paragraph"},{"end_index":7531,"paragraph_id":"1A1E473D","paragraph_index":59,"start_index":7439,"text_preview":"（5）评估过程可追溯性不足。许多系统的评分阈值与算法参数固化在代码中，未与动作版本绑定，导致同一套动作在不同时间、不同版本下的评分标准","type":"Paragraph"},{"end_index":7599,"paragraph_id":"1CB4AADD","paragraph_index":60,"start_index":7532,"text_preview":"（6）评价维度较为单一。仅依据关节角度阈值判断动作是否达标，难以反映动作幅度、节奏、稳定性和对称性等方面的差异，评价结果的区分度有限。","type":"Paragraph"},{"end_index":7705,"paragraph_id":"037C9B2C","paragraph_index":61,"start_index":7600,"text_preview":"针对以上问题，本课题选择在浏览器端部署轻量级单姿态估计模型，结合质量门控与多维评分方法实现动作的实时量化评估，并以动作版本快照保证参","type":"Paragraph"},{"end_index":7717,"heading_level":2,"paragraph_id":"6EDE4309","paragraph_index":62,"start_index":7706,"text_preview":"1.5  论文组织结构","type":"Heading"},{"end_index":7735,"paragraph_id":"0ECB521E","paragraph_index":63,"start_index":7718,"text_preview":"本文共分为六章，各章内容安排如下：","type":"Paragraph"},{"end_index":7788,"paragraph_id":"4F2F5C27","paragraph_index":64,"start_index":7736,"text_preview":"第一章 绪论。介绍课题的研究背景、研究意义、国内外研究现状以及当前存在的主要问题，并说明本文的组织结构。","type":"Paragraph"},{"end_index":7854,"paragraph_id":"3AD94B58","paragraph_index":65,"start_index":7789,"text_preview":"第二章 关键技术及工具简介。介绍系统开发所采用的开发环境与工具，以及前端、后端、数据库与中间件和人体姿态估计与端侧推理等关键技术。","type":"Paragraph"},{"end_index":7912,"paragraph_id":"13DBF7A0","paragraph_index":66,"start_index":7855,"text_preview":"第三章 系统分析。对系统进行可行性分析，并从功能需求与非功能需求两方面进行需求分析，给出系统角色、用例与业务流程。","type":"Paragraph"},{"end_index":7982,"paragraph_id":"50A97C1B","paragraph_index":67,"start_index":7913,"text_preview":"第四章 系统设计。阐述系统的总体架构设计、功能模块设计与数据库设计，给出系统架构图、功能模块图、业务流程图以及数据库概念结构与数据表设","type":"Paragraph"},{"end_index":8027,"paragraph_id":"00CCB6D1","paragraph_index":68,"start_index":7983,"text_preview":"第五章 系统实现。按功能模块介绍系统的具体实现，给出主要功能的界面效果与前后端关键代码。","type":"Paragraph"},{"end_index":8066,"paragraph_id":"3D591E8B","paragraph_index":69,"start_index":8028,"text_preview":"第六章 系统测试。对系统进行功能测试与性能测试，并对测试结果进行分析与总结。","type":"Paragraph"},{"end_index":8084,"paragraph_id":"5D83F1AA","paragraph_index":70,"start_index":8067,"text_preview":"最后为结论、致谢与参考文献等部分。","type":"Paragraph"},{"end_index":8086,"paragraph_id":"19F03969","paragraph_index":71,"start_index":8085,"type":"Paragraph"},{"end_index":8101,"heading_level":1,"paragraph_id":"5C391B40","paragraph_index":72,"start_index":8087,"text_preview":"第二章  关键技术及工具简介","type":"Heading"},{"end_index":8116,"heading_level":2,"paragraph_id":"076EE23B","paragraph_index":73,"start_index":8102,"text_preview":"2.1  系统开发环境与工具","type":"Heading"},{"end_index":8311,"paragraph_id":"0D293780","paragraph_index":74,"start_index":8117,"text_preview":"本平台采用前后端分离的B/S架构进行开发，后端以Java语言为主，前端以TypeScript语言为主，开发与运行过程中使用的操作系统、开发工具与运行环境如表","type":"Paragraph"},{"end_index":8327,"paragraph_id":"68B536E7","paragraph_index":75,"start_index":8312,"text_preview":"表2-1  系统开发环境与工具","type":"Paragraph"},{"col_count":2,"end_index":8576,"first_row_texts":["",""],"paragraph_index":76,"row_count":11,"start_index":8328,"table_end":8576,"table_id":"997geyxl","table_index":0,"table_start":8328,"type":"Table"},{"end_index":8588,"heading_level":2,"paragraph_id":"5F82A8DB","paragraph_index":77,"start_index":8577,"text_preview":"2.2  前端相关技术","type":"Heading"},{"end_index":8609,"heading_level":3,"paragraph_id":"5102A5D9","paragraph_index":78,"start_index":8589,"text_preview":"2.2.1  Vue.js 与 Vite","type":"Heading"},{"end_index":8810,"paragraph_id":"6A1F0D09","paragraph_index":79,"start_index":8610,"text_preview":"Vue.js是一款用于构建用户界面的渐进式JavaScript框架。本平台前端采用Vue 3.4版本，其组合式API（Composition API）允许将同一业务逻辑的状态、计算属性与副","type":"Paragraph"},{"end_index":8968,"paragraph_id":"3030B716","paragraph_index":80,"start_index":8811,"text_preview":"Vite是新一代前端构建工具，开发环境下基于浏览器原生ES模块加载源码，配合依赖预构建实现了快速的冷启动与热更新；生产环境下基于Rollup进行打包","type":"Paragraph"},{"end_index":8999,"heading_level":3,"paragraph_id":"5BF501A7","paragraph_index":81,"start_index":8969,"text_preview":"2.2.2  Element Plus 与 Vant 组件库","type":"Heading"},{"end_index":9128,"paragraph_id":"1E49AE62","paragraph_index":82,"start_index":9000,"text_preview":"Element Plus是一套基于Vue 3的桌面端组件库，提供了表格、表单、分页、对话框、级联选择等丰富的组件，能够较好地满足管理端大量数据录入与展示的需","type":"Paragraph"},{"end_index":9282,"paragraph_id":"23CBEAC9","paragraph_index":83,"start_index":9129,"text_preview":"Vant是一套轻量、可靠的移动端组件库，组件风格适配移动设备，交互方式贴近手机使用习惯。本平台用户端同时承载患者端与治疗师端，其计划查看、","type":"Paragraph"},{"end_index":9314,"heading_level":3,"paragraph_id":"6AEEEA19","paragraph_index":84,"start_index":9283,"text_preview":"2.2.3  Pinia、Vue Router 与 Axios","type":"Heading"},{"end_index":9402,"paragraph_id":"4910B180","paragraph_index":85,"start_index":9315,"text_preview":"Pinia是Vue的官方状态管理库，以store的形式集中管理跨组件共享的状态。本平台使用Pinia保存用户登录信息、权限角色以及训练过程中的会话状态，便于","type":"Paragraph"},{"end_index":9500,"paragraph_id":"660F7615","paragraph_index":86,"start_index":9403,"text_preview":"Vue Router是Vue官方提供的路由管理器。本平台用户端在用户登录后依据角色将请求分发到患者端或治疗师端路由，并通过全局前置守卫对未登录或无权限","type":"Paragraph"},{"end_index":9647,"paragraph_id":"5DF1A68B","paragraph_index":87,"start_index":9501,"text_preview":"Axios是一个基于Promise的HTTP客户端，用于在浏览器中发起异步请求。本平台对Axios进行统一封装，在请求拦截器中自动为请求添加认证令牌，在响应拦截","type":"Paragraph"},{"end_index":9659,"heading_level":2,"paragraph_id":"22071589","paragraph_index":88,"start_index":9648,"text_preview":"2.3  后端相关技术","type":"Heading"},{"end_index":9678,"heading_level":3,"paragraph_id":"642EDAE4","paragraph_index":89,"start_index":9660,"text_preview":"2.3.1  Spring Boot","type":"Heading"},{"end_index":9902,"paragraph_id":"7415C88A","paragraph_index":90,"start_index":9679,"text_preview":"Spring Boot是基于Spring框架的快速开发框架，通过自动配置与起步依赖显著简化了企业级应用的搭建过程。本平台后端基于Spring Boot 3.2.5构建，运行于JDK 17","type":"Paragraph"},{"end_index":10045,"paragraph_id":"5CBA6D34","paragraph_index":91,"start_index":9903,"text_preview":"在工程结构上，后端按照公共基础、领域模型与接口层进行模块化划分：公共基础模块提供统一响应结构、全局异常处理、通用工具与常量定义；领域","type":"Paragraph"},{"end_index":10065,"heading_level":3,"paragraph_id":"391D0D12","paragraph_index":92,"start_index":10046,"text_preview":"2.3.2  MyBatis-Plus","type":"Heading"},{"end_index":10258,"paragraph_id":"71E69999","paragraph_index":93,"start_index":10066,"text_preview":"MyBatis-Plus是MyBatis的增强工具，在不改变MyBatis原有功能的前提下提供了大量便捷特性。本平台使用MyBatis-Plus 3.5.7作为持久层框架，其通用Mapper为常见的增","type":"Paragraph"},{"end_index":10352,"paragraph_id":"197F2328","paragraph_index":94,"start_index":10259,"text_preview":"此外，平台通过全局配置开启了驼峰与下划线字段的自动映射，并统一约定了逻辑删除字段，使带有逻辑删除标记的数据查询自动过滤已删除记录，同","type":"Paragraph"},{"end_index":10369,"heading_level":3,"paragraph_id":"1A39B4C2","paragraph_index":95,"start_index":10353,"text_preview":"2.3.3  安全与认证相关技术","type":"Heading"},{"end_index":10554,"paragraph_id":"403CF7E4","paragraph_index":96,"start_index":10370,"text_preview":"JWT（JSON Web Token）是一种紧凑的、自包含的令牌格式，适用于前后端分离架构下的无状态认证。本平台使用JJWT 0.12.6生成与解析令牌，用户登录成功后由","type":"Paragraph"},{"end_index":10754,"paragraph_id":"6D6833B5","paragraph_index":97,"start_index":10555,"text_preview":"Redis用于存储登录会话、登录失败计数与锁定状态、幂等控制以及热点数据缓存。当用户在短时间内连续输错密码达到设定次数时，系统将其账号临时锁","type":"Paragraph"},{"end_index":10770,"heading_level":3,"paragraph_id":"4216BAAD","paragraph_index":98,"start_index":10755,"text_preview":"2.3.4  接口文档与工具库","type":"Heading"},{"end_index":10868,"paragraph_id":"736F92DF","paragraph_index":99,"start_index":10771,"text_preview":"Knife4j是一套基于OpenAPI 3规范的接口文档增强工具。本平台后端集成Knife4j 4.5.0，通过注解为接口补充描述信息，启动后即可访问在线接口文档页面，便于","type":"Paragraph"},{"end_index":11072,"paragraph_id":"673C877E","paragraph_index":100,"start_index":10869,"text_preview":"在工具库方面，平台引入Hutool工具集，用于字符串处理、日期处理、加密与二维码等常见操作，减少重复代码。数据库结构变更通过Flyway进行版本化迁","type":"Paragraph"},{"end_index":11085,"heading_level":2,"paragraph_id":"1C9AAF07","paragraph_index":101,"start_index":11073,"text_preview":"2.4  数据库与中间件","type":"Heading"},{"end_index":11098,"heading_level":3,"paragraph_id":"15E1D8E9","paragraph_index":102,"start_index":11086,"text_preview":"2.4.1  MySQL","type":"Heading"},{"end_index":11318,"paragraph_id":"1D857469","paragraph_index":103,"start_index":11099,"text_preview":"MySQL是目前应用广泛的开源关系型数据库管理系统。本平台使用MySQL 8.0作为业务数据库，采用InnoDB存储引擎，支持事务与外键约束，字符集使用utf8mb4以","type":"Paragraph"},{"end_index":11331,"heading_level":3,"paragraph_id":"14F3AE8C","paragraph_index":104,"start_index":11319,"text_preview":"2.4.2  Redis","type":"Heading"},{"end_index":11522,"paragraph_id":"00DA6920","paragraph_index":105,"start_index":11332,"text_preview":"Redis是一种基于内存的高性能键值数据库，常用于缓存、会话存储与计数统计等场景。本平台使用Redis 7.2，主要承担三方面职责：一是保存登录会话与令","type":"Paragraph"},{"end_index":11535,"heading_level":3,"paragraph_id":"3804834D","paragraph_index":106,"start_index":11523,"text_preview":"2.4.3  MinIO","type":"Heading"},{"end_index":11713,"paragraph_id":"3A28655D","paragraph_index":107,"start_index":11536,"text_preview":"MinIO是一款兼容Amazon S3协议的高性能对象存储服务，适合存储图片、视频与附件等非结构化数据。本平台的公共内容附件、动作演示素材以及咨询中的图","type":"Paragraph"},{"end_index":11732,"heading_level":2,"paragraph_id":"78DEAF60","paragraph_index":108,"start_index":11714,"text_preview":"2.5  人体姿态估计与端侧推理技术","type":"Heading"},{"end_index":11756,"heading_level":3,"paragraph_id":"25A30C84","paragraph_index":109,"start_index":11733,"text_preview":"2.5.1  MoveNet 人体姿态估计模型","type":"Heading"},{"end_index":12036,"paragraph_id":"5B6111F3","paragraph_index":110,"start_index":11757,"text_preview":"MoveNet是Google提出的一种轻量级单人姿态估计模型，采用单阶段的热力图回归结构，直接预测人体关键点的位置与置信度，输出包括鼻、左右眼、左右耳","type":"Paragraph"},{"end_index":12196,"paragraph_id":"34684227","paragraph_index":111,"start_index":12037,"text_preview":"相较于需要多人关键点匹配的自底向上方法，单人模型无需进行关键点分组，后处理流程更为简洁；同时其17个关键点的定义覆盖了康复训练中常用的肩","type":"Paragraph"},{"end_index":12226,"heading_level":3,"paragraph_id":"2E1E1D71","paragraph_index":112,"start_index":12197,"text_preview":"2.5.2  ONNX Runtime Web 与跨源隔离","type":"Heading"},{"end_index":12447,"paragraph_id":"57738ADE","paragraph_index":113,"start_index":12227,"text_preview":"ONNX Runtime Web是ONNX Runtime的Web版本，能够在浏览器中加载并执行ONNX格式的神经网络模型，支持WebAssembly与WebGL等多种后端。本平台将MoveNet Lightning模型导出","type":"Paragraph"},{"end_index":12735,"paragraph_id":"5958F427","paragraph_index":114,"start_index":12448,"text_preview":"多线程WebAssembly依赖跨源隔离环境才能使用共享内存，因此平台在部署时通过Nginx为用户端页面设置跨源隔离响应头，使页面进入跨源隔离状态；在开发","type":"Paragraph"},{"end_index":12737,"paragraph_id":"1A962364","paragraph_index":115,"start_index":12736,"type":"Paragraph"},{"end_index":12747,"heading_level":1,"paragraph_id":"2C47DAED","paragraph_index":116,"start_index":12738,"text_preview":"第三章  系统分析","type":"Heading"},{"end_index":12760,"heading_level":2,"paragraph_id":"259C2D83","paragraph_index":117,"start_index":12748,"text_preview":"3.1  系统可行性分析","type":"Heading"},{"end_index":12773,"heading_level":3,"paragraph_id":"5AF50115","paragraph_index":118,"start_index":12761,"text_preview":"3.1.1  技术可行性","type":"Heading"},{"end_index":12971,"paragraph_id":"3C5AC947","paragraph_index":119,"start_index":12774,"text_preview":"本系统后端采用Spring Boot 3.2.5与JDK 17进行开发，持久层使用MyBatis-Plus，数据存储采用MySQL 8.0，缓存采用Redis 7.2，文件存储采用MinIO；前端基于Vue 3.4与Vite 5","type":"Paragraph"},{"end_index":13305,"paragraph_id":"2F7336C6","paragraph_index":120,"start_index":12972,"text_preview":"本课题在技术上需要重点解决的问题，是如何在普通家用设备的浏览器中完成人体姿态的实时估计。针对这一问题，平台选用Google提出的轻量级单人姿","type":"Paragraph"},{"end_index":13415,"paragraph_id":"2B208C6B","paragraph_index":121,"start_index":13306,"text_preview":"此外，系统涉及的业务功能以常见的增删改查、流程审批与数据统计为主，均可以基于现有框架的标准能力实现。课题开发人员具备Java与前端开发的实","type":"Paragraph"},{"end_index":13428,"heading_level":3,"paragraph_id":"347FA199","paragraph_index":122,"start_index":13416,"text_preview":"3.1.2  操作可行性","type":"Heading"},{"end_index":13591,"paragraph_id":"71B6E73E","paragraph_index":123,"start_index":13429,"text_preview":"系统采用B/S架构，用户无需安装任何客户端软件，通过浏览器即可访问。康复患者端使用移动端组件库构建，界面适配手机屏幕，患者只需一部带摄像","type":"Paragraph"},{"end_index":13735,"paragraph_id":"71B27EF3","paragraph_index":124,"start_index":13592,"text_preview":"治疗师端与管理端使用桌面端组件库构建，界面以列表、表单与图表为主，布局方式符合管理类系统的使用习惯。系统按角色划分功能入口，不同角色","type":"Paragraph"},{"end_index":13748,"heading_level":3,"paragraph_id":"785D05A1","paragraph_index":125,"start_index":13736,"text_preview":"3.1.3  经济可行性","type":"Heading"},{"end_index":13894,"paragraph_id":"34845D40","paragraph_index":126,"start_index":13749,"text_preview":"系统所采用的开发框架、数据库、缓存、对象存储以及姿态估计模型均为开源或免费提供，不产生软件许可费用。姿态推理在用户浏览器端完成，对服","type":"Paragraph"},{"end_index":14032,"paragraph_id":"7F17B8FE","paragraph_index":127,"start_index":13895,"text_preview":"从使用价值来看，平台能够自动完成动作观察、计数与评分，将治疗师从重复性的现场观察工作中解放出来，使其能够同时服务更多患者，提高了康复","type":"Paragraph"},{"end_index":14044,"heading_level":2,"paragraph_id":"68795324","paragraph_index":128,"start_index":14033,"text_preview":"3.2  系统需求分析","type":"Heading"},{"end_index":14060,"heading_level":3,"paragraph_id":"0CFA9B4D","paragraph_index":129,"start_index":14045,"text_preview":"3.2.1  系统功能需求分析","type":"Heading"},{"end_index":14069,"heading_level":3,"paragraph_id":"1D0C413D","paragraph_index":130,"start_index":14061,"text_preview":"① 系统用户分析","type":"Heading"},{"end_index":14129,"paragraph_id":"73E054DE","paragraph_index":131,"start_index":14070,"text_preview":"根据康复训练业务的实际参与情况，系统划分为康复患者、康复治疗师和系统管理员三类角色，角色固定，不支持动态配置其他角色。","type":"Paragraph"},{"end_index":14343,"paragraph_id":"36FD5194","paragraph_index":132,"start_index":14130,"text_preview":"康复患者是训练的执行者。患者账号由管理员统一建立，并由管理员建立患者与治疗师的绑定关系；只有在存在有效主责治疗师的情况下，患者才能查","type":"Paragraph"},{"end_index":14488,"paragraph_id":"13328659","paragraph_index":133,"start_index":14344,"text_preview":"康复治疗师是康复方案的组织者。治疗师通过工作台管理其负责的患者，为患者制定康复计划并跟踪执行情况，查看训练数据、审核评估报告并回复患","type":"Paragraph"},{"end_index":14646,"paragraph_id":"7B590FBA","paragraph_index":134,"start_index":14489,"text_preview":"系统管理员是平台的运维者。管理员负责患者与治疗师账号的建立、启用、禁用与密码重置，维护患者与治疗师之间的绑定关系，维护标准动作库与评","type":"Paragraph"},{"end_index":14654,"heading_level":3,"paragraph_id":"6AA06C46","paragraph_index":135,"start_index":14647,"text_preview":"② 系统用例图","type":"Heading"},{"end_index":14764,"paragraph_id":"66323692","paragraph_index":136,"start_index":14655,"text_preview":"用例图用于描述参与者与系统之间的交互关系。本系统三类角色各自独立使用一端，因此分别绘制患者端、治疗师端与管理端用例图。其中，执行实时","type":"Paragraph"},{"end_index":14958,"paragraph_id":"0FBC9A96","paragraph_index":137,"start_index":14765,"text_preview":"康复患者端的用例如图3-1所示。患者可以注册登录、查看康复计划、执行实时训练、查看训练记录、学习康复内容、在线咨询以及进行AI康复问答。其中","type":"Paragraph"},{"end_index":14960,"paragraph_id":"4C0ECCB9","paragraph_index":138,"start_index":14959,"text_preview":"[Image]","type":"Paragraph"},{"end_index":14975,"paragraph_id":"09776BD0","paragraph_index":139,"start_index":14961,"text_preview":"图3-1  康复患者端用例图","type":"Paragraph"},{"end_index":15186,"paragraph_id":"31A00CF1","paragraph_index":140,"start_index":14976,"text_preview":"康复治疗师端的用例如图3-2所示。治疗师可以注册登录、管理负责患者、制定康复计划、查看训练数据、审核评估报告、回复患者咨询以及查看公告。","type":"Paragraph"},{"end_index":15188,"paragraph_id":"75D25C14","paragraph_index":141,"start_index":15187,"text_preview":"[Image]","type":"Paragraph"},{"end_index":15204,"paragraph_id":"10459C0D","paragraph_index":142,"start_index":15189,"text_preview":"图3-2  康复治疗师端用例图","type":"Paragraph"},{"end_index":15394,"paragraph_id":"0737A256","paragraph_index":143,"start_index":15205,"text_preview":"系统管理端的用例如图3-3所示。管理员可以注册登录、管理账号与绑定关系、维护动作库与规则、审核公共内容、发布公告以及进行系统运维。其中，","type":"Paragraph"},{"end_index":15396,"paragraph_id":"7BA02D36","paragraph_index":144,"start_index":15395,"text_preview":"[Image]","type":"Paragraph"},{"end_index":15411,"paragraph_id":"06F93658","paragraph_index":145,"start_index":15397,"text_preview":"图3-3  系统管理端用例图","type":"Paragraph"},{"end_index":15420,"heading_level":3,"paragraph_id":"1685EEAA","paragraph_index":146,"start_index":15412,"text_preview":"③ 系统功能分析","type":"Heading"},{"end_index":15480,"paragraph_id":"6DE02CCE","paragraph_index":147,"start_index":15421,"text_preview":"在上述角色与用例分析的基础上，结合康复训练业务的实际流程，系统按照业务职责划分为七个功能域，各功能域及其主要功能如下。","type":"Paragraph"},{"end_index":15489,"paragraph_id":"7DD67341","paragraph_index":148,"start_index":15481,"text_preview":"1．账户与权限域","type":"Paragraph"},{"end_index":15621,"paragraph_id":"48FB021B","paragraph_index":149,"start_index":15490,"text_preview":"负责三类角色的账号体系与访问控制，主要包括：注册登录、图形验证码校验、密码修改、个人资料维护、登录记录查询；管理员对患者与治疗师账号","type":"Paragraph"},{"end_index":15630,"paragraph_id":"58FD4B96","paragraph_index":150,"start_index":15622,"text_preview":"2．动作与算法域","type":"Paragraph"}],"pagination":{"has_more":true,"limit":150,"offset":0,"returned_nodes":150,"total_nodes":171},"stats":{"total_headings":40,"total_numbering_lists":0,"total_paragraphs":130,"total_tables":1},"version":0}
