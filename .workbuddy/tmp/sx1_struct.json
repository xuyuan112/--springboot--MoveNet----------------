{"effective_mode":"compact","effective_text_preview_length":200,"nodes":[{"end_index":0,"paragraph_index":1,"start_index":0,"type":"Paragraph"},{"col_count":4,"end_index":172,"first_row_texts":["","",""],"paragraph_index":2,"row_count":5,"start_index":1,"table_end":172,"table_id":"ewqn9s8t","table_index":0,"table_start":1,"type":"Table"},{"end_index":173,"paragraph_index":3,"start_index":173,"type":"Paragraph"},{"end_index":174,"paragraph_index":4,"start_index":174,"type":"Paragraph"},{"end_index":256,"paragraph_index":5,"start_index":175,"text_preview":"*********************************************************************************","type":"Paragraph"},{"end_index":267,"paragraph_index":6,"start_index":257,"text_preview":"实训1 项目需求分析","type":"Paragraph"},{"end_index":277,"paragraph_index":7,"start_index":268,"text_preview":"一、实践目的及要求","type":"Paragraph"},{"end_index":286,"is_numbering":true,"num_id":"00002f","numbering_level":1,"numbering_type":"bullet","paragraph_index":8,"start_index":278,"text_preview":"掌握需求分析方法","type":"Paragraph"},{"end_index":298,"is_numbering":true,"num_id":"00002f","numbering_level":1,"numbering_type":"bullet","paragraph_index":9,"start_index":287,"text_preview":"编写规范的需求规格说明","type":"Paragraph"},{"end_index":305,"paragraph_index":10,"start_index":299,"text_preview":"二、注意事项","type":"Paragraph"},{"end_index":323,"is_numbering":true,"num_id":"00002f","numbering_level":1,"numbering_type":"bullet","paragraph_index":11,"start_index":306,"text_preview":"严禁抄袭，若有雷同，发现则成绩无效","type":"Paragraph"},{"end_index":344,"is_numbering":true,"num_id":"00002f","numbering_level":1,"numbering_type":"bullet","paragraph_index":12,"start_index":324,"text_preview":"字体大小为宋体5号和段落间距固定值18磅","type":"Paragraph"},{"end_index":375,"is_numbering":true,"num_id":"00002f","numbering_level":1,"numbering_type":"bullet","paragraph_index":13,"start_index":345,"text_preview":"图片大小设置适中，图片不可太大，也不可太小，能看清图片中的字","type":"Paragraph"},{"end_index":391,"is_numbering":true,"num_id":"00002f","numbering_level":1,"numbering_type":"bullet","paragraph_index":14,"start_index":376,"text_preview":"控制内容，实践内容不可超过5页","type":"Paragraph"},{"end_index":400,"paragraph_index":15,"start_index":392,"text_preview":"三、课程实践步骤","type":"Paragraph"},{"end_index":401,"paragraph_index":16,"start_index":401,"type":"Paragraph"},{"end_index":482,"has_highlights":true,"paragraph_index":17,"start_index":402,"text_preview":"题目：          基于springboot框架MoveNet姿态评估康复训练平台                                    ","type":"Paragraph"},{"end_index":483,"paragraph_index":18,"start_index":483,"type":"Paragraph"},{"end_index":494,"paragraph_index":19,"start_index":484,"text_preview":"一、系统总体需求分析","type":"Paragraph"},{"end_index":530,"paragraph_index":20,"start_index":495,"text_preview":"本章从研究背景、总体需求与技术选型三个方面，说明系统的建设背景与目标。","type":"Paragraph"},{"end_index":544,"paragraph_index":21,"start_index":531,"text_preview":"1.1 研究背景与现状问题","type":"Paragraph"},{"end_index":611,"paragraph_index":22,"start_index":545,"text_preview":"康复训练是疾病或损伤后恢复身体功能的重要手段。传统康复训练主要依赖治疗师与患者\"一对一、面对面\"指导，在实践过程中存在以下突出问题：","type":"Paragraph"},{"end_index":671,"paragraph_index":23,"start_index":612,"text_preview":"1.专业资源有限、覆盖不足：康复训练需要专业治疗师全程参与，人力成本高、服务能力有限，难以满足大量患者的居家康复需求。","type":"Paragraph"},{"end_index":672,"paragraph_index":24,"start_index":672,"type":"Paragraph"},{"end_index":751,"is_numbering":true,"num_id":"000030","numbering_level":1,"numbering_type":"decimal","paragraph_index":25,"start_index":673,"text_preview":"居家训练缺乏指导、动作不规范：患者离开医院后，康复训练缺乏实时专业指导，动作不规范（代偿、关节角度不到位）难以及时发现，轻则影响康复","type":"Paragraph"},{"end_index":752,"paragraph_index":26,"start_index":752,"type":"Paragraph"},{"end_index":830,"is_numbering":true,"num_id":"000030","numbering_level":1,"numbering_type":"decimal","paragraph_index":27,"start_index":753,"text_preview":"康复过程缺乏量化数据：传统康复评估依赖治疗师主观经验，训练过程缺乏客观量化数据，医患信息不对称，治疗师难以掌握患者真实训练情况，后续","type":"Paragraph"},{"end_index":831,"paragraph_index":28,"start_index":831,"type":"Paragraph"},{"end_index":845,"paragraph_index":29,"start_index":832,"text_preview":"1.2 总体需求与核心价值","type":"Paragraph"},{"end_index":970,"paragraph_index":30,"start_index":846,"text_preview":"针对上述问题，本平台旨在构建一个面向康复患者、康复治疗师、系统管理员三类用户的 Web 端居家康复训练平台。平台以 Google MoveNet 轻量级姿态估计","type":"Paragraph"},{"end_index":971,"paragraph_index":31,"start_index":971,"type":"Paragraph"},{"end_index":1013,"paragraph_index":32,"start_index":972,"text_preview":"1.通过浏览器调用普通摄像头，实时识别患者姿态、计算关节角度，实现动作规范性评估；","type":"Paragraph"},{"end_index":1053,"paragraph_index":33,"start_index":1014,"text_preview":"2.与标准动作比对，对不规范动作进行实时评分与纠错矫正，辅助患者居家规范训练；","type":"Paragraph"},{"end_index":1093,"paragraph_index":34,"start_index":1054,"text_preview":"3.自动记录训练数据，生成训练报告与康复进度分析，为康复评估提供客观量化依据；","type":"Paragraph"},{"end_index":1135,"paragraph_index":35,"start_index":1094,"text_preview":"4.康复治疗师基于报告分析结果，精准调整后续康复训练方案，形成持续优化的康复闭环；","type":"Paragraph"},{"end_index":1177,"paragraph_index":36,"start_index":1136,"text_preview":"5.建立完善的康复计划管理机制与权限分级机制，保障系统的实时性、准确性与数据安全。","type":"Paragraph"},{"end_index":1178,"paragraph_index":37,"start_index":1178,"type":"Paragraph"},{"end_index":1189,"paragraph_index":38,"start_index":1179,"text_preview":"1.3 技术选型说明","type":"Paragraph"},{"end_index":1320,"paragraph_index":39,"start_index":1190,"text_preview":"MoveNet：Google 推出的轻量级姿态估计模型，可在浏览器端（TensorFlow.js）或移动端（TFLite）实时运行，无需 GPU 服务器；其 17 个身体关键点足以覆盖全身","type":"Paragraph"},{"end_index":1372,"paragraph_index":40,"start_index":1321,"text_preview":"Web 形态：免安装、跨平台，患者打开浏览器即可训练，降低使用门槛；浏览器端离线运行亦可保护患者隐私。","type":"Paragraph"},{"end_index":1381,"paragraph_index":41,"start_index":1373,"text_preview":"二、用户需求分析","type":"Paragraph"},{"end_index":1395,"paragraph_index":42,"start_index":1382,"text_preview":"系统主要用户角色包括三类：","type":"Paragraph"},{"end_index":1409,"paragraph_index":43,"start_index":1396,"text_preview":"2.1 康复患者（角色A）","type":"Paragraph"},{"end_index":1515,"paragraph_index":44,"start_index":1410,"text_preview":"负责执行康复训练、接收矫正反馈、查看报告与进度。主要功能包括：注册登录、完善个人信息、查看动作演示、执行康复计划、实时训练（评分/纠错/","type":"Paragraph"},{"end_index":1517,"paragraph_index":45,"start_index":1516,"text_preview":"[Image]","type":"Paragraph"},{"end_index":1532,"paragraph_index":46,"start_index":1518,"text_preview":"2.2 康复治疗师（角色B）","type":"Paragraph"},{"end_index":1604,"paragraph_index":47,"start_index":1533,"text_preview":"负责制定训练方案、评估康复效果、调整后续训练。主要功能包括：患者管理、制定并下发康复计划、查看训练数据、生成评估报告、发布康复内容、","type":"Paragraph"},{"end_index":1606,"paragraph_index":48,"start_index":1605,"text_preview":"[Image]","type":"Paragraph"},{"end_index":1621,"paragraph_index":49,"start_index":1607,"text_preview":"2.3 系统管理员（角色C）","type":"Paragraph"},{"end_index":1680,"paragraph_index":50,"start_index":1622,"text_preview":"负责系统运行维护。主要功能包括：用户账号管理、角色与权限配置、动作库维护、内容审核、数据与日志管理、系统参数与公告。","type":"Paragraph"},{"end_index":1682,"paragraph_index":51,"start_index":1681,"text_preview":"[Image]","type":"Paragraph"},{"end_index":1689,"is_numbering":true,"num_id":"000031","numbering_level":1,"numbering_type":"decimal_comma","paragraph_index":52,"start_index":1683,"text_preview":"功能需求分析","type":"Paragraph"},{"end_index":1701,"paragraph_index":53,"start_index":1690,"text_preview":"3.1 账户与个人资料","type":"Paragraph"},{"end_index":1789,"paragraph_index":54,"start_index":1702,"text_preview":"目的：患者端的第一道门，负责身份认证、资料维护与治疗师关系查看。患者账号由管理员创建，因此本模块的重点不在注册流程本身，而在于账号状","type":"Paragraph"},{"end_index":1794,"paragraph_index":55,"start_index":1790,"text_preview":"功能要点","type":"Paragraph"},{"end_index":1847,"paragraph_index":56,"start_index":1795,"text_preview":"登录认证：支持账号或手机号登录；密码使用 BCrypt 加盐存储；连续登录失败 5 次锁定 30 分钟。","type":"Paragraph"},{"end_index":1907,"paragraph_index":57,"start_index":1848,"text_preview":"登录留痕：登录成功与失败均写入 operation_log(module='AUTH')，记录设备标识、IP 与时间。","type":"Paragraph"},{"end_index":1969,"paragraph_index":58,"start_index":1908,"text_preview":"资料维护：维护姓名、性别、出生日期（前端换算展示年龄，不直接存年龄）、身高、体重、康复部位、病史摘要、过敏信息与禁忌说明。","type":"Paragraph"},{"end_index":2014,"paragraph_index":59,"start_index":1970,"text_preview":"查看我的治疗师：查看当前负责治疗师信息；无绑定时提示联系管理员，不提供患者自助绑定入口。","type":"Paragraph"},{"end_index":2071,"paragraph_index":60,"start_index":2015,"text_preview":"安全设置：修改密码、退出登录、查看本人登录记录（来源 operation_log）；不做永久在线设备的远程管理。","type":"Paragraph"},{"end_index":2079,"paragraph_index":61,"start_index":2072,"text_preview":"关键规则与约束","type":"Paragraph"},{"end_index":2113,"paragraph_index":62,"start_index":2080,"text_preview":"患者不能自行注册或绕过账号状态校验；账号被禁用后相关令牌立即失效。","type":"Paragraph"},{"end_index":2153,"paragraph_index":63,"start_index":2114,"text_preview":"病史等敏感字段按最小必要原则收集，患者可编辑字段与治疗师可查看字段须分别定义。","type":"Paragraph"},{"end_index":2218,"paragraph_index":64,"start_index":2154,"text_preview":"所有请求经 JWT 认证 + 角色校验 + 对象级归属校验，患者只能访问 patient_id 等于当前登录用户 ID 的数据。","type":"Paragraph"},{"end_index":2220,"paragraph_index":65,"start_index":2219,"text_preview":"[Image]","type":"Paragraph"},{"end_index":2236,"paragraph_index":66,"start_index":2221,"text_preview":"3.2 我的康复计划与每日任务","type":"Paragraph"},{"end_index":2312,"paragraph_index":67,"start_index":2237,"text_preview":"目的：把治疗师制定的计划翻译成患者当天“要做什么、做多少”，是训练闭环的执行入口。患者侧只有“查看与执行”权限，计划归属与完成状态均","type":"Paragraph"},{"end_index":2317,"paragraph_index":68,"start_index":2313,"text_preview":"功能要点","type":"Paragraph"},{"end_index":2381,"paragraph_index":69,"start_index":2318,"text_preview":"查看我的康复计划：查看当前有效计划的起止日期、训练频率、注意事项，以及动作项的顺序、组数、次数、目标幅度、单组时长与休息时间。","type":"Paragraph"},{"end_index":2450,"paragraph_index":70,"start_index":2382,"text_preview":"查看今日训练任务：从“今日训练”进入当日任务列表（当日多条任务的聚合），每条任务显示待训练、进行中、已完成、部分完成、跳过、已过期状","type":"Paragraph"},{"end_index":2488,"paragraph_index":71,"start_index":2451,"text_preview":"查看进度与三级完成度：查看任务进度、动作项完成情况、日完成度与计划完成度。","type":"Paragraph"},{"end_index":2530,"paragraph_index":72,"start_index":2489,"text_preview":"暂停或结束训练：训练中可暂停或结束，并记录未完成原因；不强制患者在疼痛时完成动作。","type":"Paragraph"},{"end_index":2578,"paragraph_index":73,"start_index":2531,"text_preview":"生成每日训练任务（定时任务）：按计划频率与日期范围自动生成每日任务，患者无需手工确认计划归属。","type":"Paragraph"},{"end_index":2586,"paragraph_index":74,"start_index":2579,"text_preview":"关键规则与约束","type":"Paragraph"},{"end_index":2623,"paragraph_index":75,"start_index":2587,"text_preview":"任务粒度为“计划动作项 × 日期”，同一计划动作同一日期只生成一条任务。","type":"Paragraph"},{"end_index":2747,"paragraph_index":76,"start_index":2624,"text_preview":"任务状态判定口径：correct_reps >= target_reps 为 COMPLETED；0 < correct_reps < target_reps 为 PARTIAL；无记录且跨过当天 23:59:59 由定时任务置 EXPIRED。","type":"Paragraph"},{"end_index":2810,"paragraph_index":77,"start_index":2748,"text_preview":"每日 00:10 生成当日任务；DAILY 每天生成，WEEKLY 仅在 plan_schedule.weekday 生成。","type":"Paragraph"},{"end_index":2898,"paragraph_index":78,"start_index":2811,"text_preview":"三级完成度由服务端计算：日完成度 = 当日已完成任务数 / 当日应执行任务数；计划完成度 = 已完成任务数 / 累计已生成任务数；动作项完成度按该动","type":"Paragraph"},{"end_index":2924,"paragraph_index":79,"start_index":2899,"text_preview":"已结束或作废的计划只读归档，不再产生新的训练记录。","type":"Paragraph"},{"end_index":2926,"paragraph_index":80,"start_index":2925,"text_preview":" ","type":"Paragraph"},{"end_index":2928,"paragraph_index":81,"start_index":2927,"text_preview":"[Image]","type":"Paragraph"},{"end_index":2930,"paragraph_index":82,"start_index":2929,"text_preview":" ","type":"Paragraph"},{"end_index":2941,"paragraph_index":83,"start_index":2931,"text_preview":"3.3 实时姿态评估","type":"Paragraph"},{"end_index":3015,"paragraph_index":84,"start_index":2942,"text_preview":"目的：平台的核心模块，把摄像头画面转化为可解释、可复核的康复训练评价。评估全程在患者浏览器本地执行，原始视频不出本地，服务端只接收结","type":"Paragraph"},{"end_index":3020,"paragraph_index":85,"start_index":3016,"text_preview":"功能要点","type":"Paragraph"},{"end_index":3086,"paragraph_index":86,"start_index":3021,"text_preview":"四层评估链路：姿态获取层 → 质量保障层 → 特征计算层 → 评分纠错层，逐级串联，全部在浏览器端完成（详见需求说明书 6.3）。","type":"Paragraph"},{"end_index":3176,"paragraph_index":87,"start_index":3087,"text_preview":"姿态获取：授权摄像头并按站位引导完成定位（全身可见、单人入镜、光线充足、相机固定）；MoveNet 逐帧输出 17 个关键点及置信度，每 N 帧更新一次","type":"Paragraph"},{"end_index":3255,"paragraph_index":88,"start_index":3177,"text_preview":"质量保障：关键点置信度三级门控；对角度序列做中值滤波与指数平滑；对短暂缺失帧做邻域插值；对长时间不可见的肢体末端关节，用骨段长度与父","type":"Paragraph"},{"end_index":3337,"paragraph_index":89,"start_index":3256,"text_preview":"特征计算：以髋中心为原点、身高或肩宽为尺度做骨架归一化，消除体型与站距差异；计算关节角度、活动幅度（ROM）、角速度、角加速度、左右对称","type":"Paragraph"},{"end_index":3436,"paragraph_index":90,"start_index":3338,"text_preview":"评分纠错：动作阶段状态机（准备／上行／顶点保持／回落）结合双阈值滞后完成计数；按幅度、保持、节奏、稳定、对称、相似度六维加权汇总评分","type":"Paragraph"},{"end_index":3493,"paragraph_index":91,"start_index":3437,"text_preview":"结果提交：训练结束只提交与任务关联的汇总结果（含分维度评分与姿态质量指标）和必要的纠错摘要，默认不上传原始视频。","type":"Paragraph"},{"end_index":3501,"paragraph_index":92,"start_index":3494,"text_preview":"关键规则与约束","type":"Paragraph"},{"end_index":3549,"paragraph_index":93,"start_index":3502,"text_preview":"同类纠错提示 3 秒内不重复推送；计数采用双阈值滞后并叠加最小周期时长约束，避免抖动重复计数。","type":"Paragraph"},{"end_index":3615,"paragraph_index":94,"start_index":3550,"text_preview":"关键点置信度过低时暂停评分并提示重新站位，不产生不可靠评分；单次训练合格帧比例低于配置阈值时标记“姿态质量不足”，可只记录不计分。","type":"Paragraph"},{"end_index":3683,"paragraph_index":95,"start_index":3616,"text_preview":"所有算法阈值、平滑窗口、部位权重与时序参数均从任务绑定的 action_version 读取，不读取最新动作配置，保证历史训练可复现。","type":"Paragraph"},{"end_index":3710,"paragraph_index":96,"start_index":3684,"text_preview":"AI 不参与实时计数、达标判定、计划修改或医学结论。","type":"Paragraph"},{"end_index":3712,"paragraph_index":97,"start_index":3711,"text_preview":"[Image]","type":"Paragraph"},{"end_index":3714,"paragraph_index":98,"start_index":3713,"text_preview":" ","type":"Paragraph"},{"end_index":3728,"paragraph_index":99,"start_index":3715,"text_preview":"3.4 训练记录与评估报告","type":"Paragraph"},{"end_index":3797,"paragraph_index":100,"start_index":3729,"text_preview":"目的：把逐次训练的原始结果收敛为患者可读的进展证据，是患者获得正反馈、理解“为什么扣分”的窗口。患者只能看到治疗师审核生效后的正式报","type":"Paragraph"},{"end_index":3802,"paragraph_index":101,"start_index":3798,"text_preview":"功能要点","type":"Paragraph"},{"end_index":3843,"paragraph_index":102,"start_index":3803,"text_preview":"查看训练记录：按日期、计划、动作查看训练时长、总次数、达标次数、得分与纠错次数。","type":"Paragraph"},{"end_index":3920,"paragraph_index":103,"start_index":3844,"text_preview":"查看分维度评分：查看幅度、保持、节奏、稳定、对称、相似度六个维度的得分构成，以及活动幅度、保持占比、模板相似度等关键指标，并标注“姿","type":"Paragraph"},{"end_index":3952,"paragraph_index":104,"start_index":3921,"text_preview":"查看训练趋势：查看个人训练趋势、每日完成情况与计划三级完成度。","type":"Paragraph"},{"end_index":3979,"paragraph_index":105,"start_index":3953,"text_preview":"查看评估报告：查看治疗师审核生效后的阶段性评估报告。","type":"Paragraph"},{"end_index":3987,"paragraph_index":106,"start_index":3980,"text_preview":"关键规则与约束","type":"Paragraph"},{"end_index":4039,"paragraph_index":107,"start_index":3988,"text_preview":"仅状态为 EFFECTIVE 的报告对患者可见，DRAFT 与 PENDING_REVIEW 不可见。","type":"Paragraph"},{"end_index":4076,"paragraph_index":108,"start_index":4040,"text_preview":"姿态质量不足（INSUFFICIENT）的记录单独标注，不参与趋势判断。","type":"Paragraph"},{"end_index":4102,"paragraph_index":109,"start_index":4077,"text_preview":"AI 训练小结只作为辅助摘要展示，不替代正式报告。","type":"Paragraph"},{"end_index":4104,"paragraph_index":110,"start_index":4103,"text_preview":"[Image]","type":"Paragraph"},{"end_index":4106,"paragraph_index":111,"start_index":4105,"text_preview":" ","type":"Paragraph"},{"end_index":4119,"paragraph_index":112,"start_index":4107,"text_preview":"3.5 公共康复知识中心","type":"Paragraph"},{"end_index":4195,"paragraph_index":113,"start_index":4120,"text_preview":"目的：为患者提供与“个人绑定关系”无关的通用康复知识，使患者在未绑定治疗师或等待回复期间也有可靠信息可参考。内容与绑定关系解耦，更换","type":"Paragraph"},{"end_index":4200,"paragraph_index":114,"start_index":4196,"text_preview":"功能要点","type":"Paragraph"},{"end_index":4242,"paragraph_index":115,"start_index":4201,"text_preview":"浏览与筛选：按康复部位、内容分类与关键词筛选标准动作演示、康复注意事项与健康科普。","type":"Paragraph"},{"end_index":4271,"paragraph_index":116,"start_index":4243,"text_preview":"查看风险提示：每条内容展示适用部位、适用人群与风险提示。","type":"Paragraph"},{"end_index":4295,"paragraph_index":117,"start_index":4272,"text_preview":"内容收藏：收藏感兴趣的内容，形成个人知识清单。","type":"Paragraph"},{"end_index":4303,"paragraph_index":118,"start_index":4296,"text_preview":"关键规则与约束","type":"Paragraph"},{"end_index":4333,"paragraph_index":119,"start_index":4304,"text_preview":"患者端只展示审核状态为“已通过”且处于有效期内的公共内容。","type":"Paragraph"},{"end_index":4359,"paragraph_index":120,"start_index":4334,"text_preview":"内容下架后不再出现在患者端，但历史收藏记录不删除。","type":"Paragraph"},{"end_index":4404,"paragraph_index":121,"start_index":4360,"text_preview":"公共内容必须包含适用部位、适用人群和风险提示；首版不提供针对个人疾病的 AI 饮食方案。","type":"Paragraph"},{"end_index":4406,"paragraph_index":122,"start_index":4405,"text_preview":" ","type":"Paragraph"},{"end_index":4408,"paragraph_index":123,"start_index":4407,"text_preview":"[Image]","type":"Paragraph"},{"end_index":4410,"paragraph_index":124,"start_index":4409,"text_preview":" ","type":"Paragraph"},{"end_index":4426,"paragraph_index":125,"start_index":4411,"text_preview":"3.6 在线咨询与 AI 问答","type":"Paragraph"},{"end_index":4503,"paragraph_index":126,"start_index":4427,"text_preview":"目的：为患者提供求助通道：有负责治疗师时走人工咨询，暂无治疗师时用带免责声明的 AI 知识问答兜底。核心约束是任何面向前者的医疗性表述都必","type":"Paragraph"},{"end_index":4508,"paragraph_index":127,"start_index":4504,"text_preview":"功能要点","type":"Paragraph"},{"end_index":4543,"paragraph_index":128,"start_index":4509,"text_preview":"发起人工咨询：存在有效负责治疗师时，可发起咨询会话并发送文字或图片。","type":"Paragraph"},{"end_index":4575,"paragraph_index":129,"start_index":4544,"text_preview":"查看与处理消息：查看会话回复与未读数，打开会话时更新已读回执。","type":"Paragraph"},{"end_index":4601,"paragraph_index":130,"start_index":4576,"text_preview":"结束咨询会话：结束当前会话；需继续咨询时新建会话。","type":"Paragraph"},{"end_index":4647,"paragraph_index":131,"start_index":4602,"text_preview":"AI 康复知识问答：无负责治疗师时使用，使用前展示免责声明，默认不持久化、不建聊天历史表。","type":"Paragraph"},{"end_index":4655,"paragraph_index":132,"start_index":4648,"text_preview":"关键规则与约束","type":"Paragraph"},{"end_index":4708,"paragraph_index":133,"start_index":4656,"text_preview":"发起人工咨询前必须校验存在有效 patient_therapist 关系；AI 知识问答不依赖绑定关系。","type":"Paragraph"},{"end_index":4775,"paragraph_index":134,"start_index":4709,"text_preview":"未读数按 consultation_message.is_read=0 统计；已读状态用 is_read / read_at 维护。","type":"Paragraph"},{"end_index":4802,"paragraph_index":135,"start_index":4776,"text_preview":"会话关闭后进入只读状态，不修改已关闭会话的历史消息。","type":"Paragraph"},{"end_index":4823,"paragraph_index":136,"start_index":4803,"text_preview":"AI 不得自动生成处方、诊断或风险结论。","type":"Paragraph"},{"end_index":4825,"paragraph_index":137,"start_index":4824,"text_preview":"[Image]","type":"Paragraph"},{"end_index":4832,"paragraph_index":138,"start_index":4826,"text_preview":"康复治疗师端","type":"Paragraph"},{"end_index":4834,"paragraph_index":139,"start_index":4833,"text_preview":" ","type":"Paragraph"},{"end_index":4847,"paragraph_index":140,"start_index":4835,"text_preview":"3.7 工作台与患者管理","type":"Paragraph"},{"end_index":4931,"paragraph_index":141,"start_index":4848,"text_preview":"目的：治疗师每天进入系统后的第一落点，负责回答“我有哪些患者、谁需要我介入”。它把分散在各业务域的待办集中成提醒，是治疗师从“被动等","type":"Paragraph"},{"end_index":4936,"paragraph_index":142,"start_index":4932,"text_preview":"功能要点","type":"Paragraph"},{"end_index":4972,"paragraph_index":143,"start_index":4937,"text_preview":"登录认证：治疗师使用账号密码登录治疗师端，校验账号状态并写入登录日志。","type":"Paragraph"},{"end_index":5011,"paragraph_index":144,"start_index":4973,"text_preview":"工作台总览：查看当前有效负责患者列表及其康复部位、计划状态与近期训练完成度。","type":"Paragraph"},{"end_index":5044,"paragraph_index":145,"start_index":5012,"text_preview":"筛选负责患者：按姓名、康复部位和计划状态筛选，快速定位目标患者。","type":"Paragraph"},{"end_index":5076,"paragraph_index":146,"start_index":5045,"text_preview":"查看患者档案：查看患者必要档案与历史计划（仅限有效负责患者）。","type":"Paragraph"},{"end_index":5107,"paragraph_index":147,"start_index":5077,"text_preview":"三类待办提醒：待审核报告提醒、待回复咨询提醒、异常训练提示。","type":"Paragraph"},{"end_index":5128,"paragraph_index":148,"start_index":5108,"text_preview":"查看公告：查看管理员发布的当前有效公告。","type":"Paragraph"},{"end_index":5136,"paragraph_index":149,"start_index":5129,"text_preview":"关键规则与约束","type":"Paragraph"},{"end_index":5197,"paragraph_index":150,"start_index":5137,"text_preview":"所有用例均受对象级权限约束：查看任何患者数据前必须存在有效 patient_therapist 关系，非负责患者不可见。","type":"Paragraph"}],"pagination":{"has_more":true,"limit":150,"offset":0,"returned_nodes":150,"total_nodes":334},"stats":{"total_headings":0,"total_numbering_lists":9,"total_paragraphs":331,"total_tables":1},"version":0}
